- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    constellation: digital.constellation_bpsk().base()
    damping: '1.0'
    loop_bw: '0.045'
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '128'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_MMSE_8TAP
    sps: sps
    ted_gain: '1.0'
    ted_type: digital.TED_GARDNER
    type: ff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 452.0]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\nclass blk(gr.basic_block):\n\
      \    \"\"\"CC120 Deframer\"\"\"\n    def __init__(self, sync_word=\"11010110011111111110000011101\"\
      , debug=False):\n        gr.basic_block.__init__(self, name='CC1120 Deframer',\
      \ in_sig=[np.uint8], out_sig=[np.uint8])\n        self.debug = debug == \"True\"\
      \n        self.sync_word = sync_word.zfill(32)\n        self.sync_len = len(self.sync_word)\n\
      \        self.sync_val = int(self.sync_word, 2)\n        self.sync_mask = (1\
      \ << self.sync_len) - 1\n        self.state = \"SYNC\"\n        self.shift_reg\
      \ = 0\n        self.payload_len = 0\n        self.temp_payload_len = 0\n   \
      \     self.bit_counter = 0\n        self.payload = []\n        self.out_queue\
      \ = []\n\n    def forecast(self, noutput_items, ninputs):\n        return [max(1,\
      \ noutput_items * 8) for _ in range(ninputs)]\n\n    def general_work(self,\
      \ input_items, output_items):\n        in0 = input_items[0]\n        out0 =\
      \ output_items[0]\n        for val in in0:\n            bit = int(val) & 1\n\
      \            if self.state == \"SYNC\":\n                self.shift_reg = ((self.shift_reg\
      \ << 1) | bit) & self.sync_mask\n                if self.shift_reg == self.sync_val:\n\
      \                    self.state = \"LENGTH\"\n                    self.temp_payload_len\
      \ = self.bit_counter = 0\n            elif self.state == \"LENGTH\":\n     \
      \           self.temp_payload_len = (self.temp_payload_len << 1) | bit\n   \
      \             self.bit_counter += 1\n                if self.bit_counter ==\
      \ 8:\n                    self.payload_len = self.temp_payload_len\n       \
      \             self.payload = []\n                    if self.payload_len > 0:\n\
      \                        self.state = \"PAYLOAD\"\n                        self.temp_payload_len\
      \ = self.bit_counter = 0\n                    else:\n                      \
      \  self.state = \"SYNC\"\n                        self.shift_reg = 0\n     \
      \       elif self.state == \"PAYLOAD\":\n                self.temp_payload_len\
      \ = (self.temp_payload_len << 1) | bit\n                self.bit_counter +=\
      \ 1\n                if self.bit_counter == 8:\n                    self.payload.append(self.temp_payload_len)\n\
      \                    self.temp_payload_len = self.bit_counter = 0\n        \
      \            if len(self.payload) == self.payload_len:\n                   \
      \     self.out_queue.extend(self.payload)\n                        self.state\
      \ = \"SYNC\"\n                        self.shift_reg = 0\n        out_idx =\
      \ 0\n        while out_idx < len(out0) and len(self.out_queue) > 0:\n      \
      \      out0[out_idx] = self.out_queue.pop(0)\n            out_idx += 1\n   \
      \     self.consume(0, len(in0))\n        return out_idx\n"
    affinity: ''
    alias: ''
    comment: ''
    debug: 'False'
    maxoutbuf: '0'
    minoutbuf: '0'
    sync_word: '"11010110011111111110000011101"'
  states:
    _io_cache: ('CC1120 Deframer', 'blk', [('sync_word', "'11010110011111111110000011101'"),
      ('debug', 'False')], [('0', 'byte', 1)], [('0', 'byte', 1)], 'CC120 Deframer',
      ['debug', 'sync_word'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1024, 340.0]
    rotation: 0
    state: enabled
