options:
  parameters:
    author: diego
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: RTL-SDR 2FSK Reed-Solomon Packet Receiver for Field Testing
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: rtlsdr_rx_rs
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: RTL-SDR RS BFSK Packet Receiver
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: bitrate
  id: variable
  parameters:
    comment: ''
    value: '9600'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 20.0]
    rotation: 0
    state: enabled
- name: deviation
  id: variable
  parameters:
    comment: ''
    value: '4000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [368, 20.0]
    rotation: 0
    state: enabled
- name: filter_cutoff
  id: variable
  parameters:
    comment: ''
    value: deviation + bitrate / 2 + 200
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 84.0]
    rotation: 0
    state: enabled
- name: filter_transition
  id: variable
  parameters:
    comment: ''
    value: int(filter_cutoff / 4)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 84.0]
    rotation: 0
    state: enabled
- name: rf_freq
  id: variable
  parameters:
    comment: ''
    value: '433_000_000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 20.0]
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: RX Gain
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '1'
    stop: '50'
    value: '25'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [560, 20.0]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2_160_000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 20.0]
    rotation: 0
    state: enabled
- name: sens
  id: variable
  parameters:
    comment: ''
    value: samp_rate / (2 * math.pi * deviation)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 92.0]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters:
    comment: ''
    value: int(samp_rate / bitrate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [176, 84.0]
    rotation: 0
    state: enabled
- name: sync_threshold
  id: variable
  parameters:
    comment: ''
    value: '2'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [720, 28.0]
    rotation: 0
    state: enabled
- name: analog_quadrature_demod_cf_0
  id: analog_quadrature_demod_cf
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    gain: sens
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [488, 224.0]
    rotation: 0
    state: enabled
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: output_rs.txt
    type: byte
    unbuffered: 'True'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1320, 196.0]
    rotation: 0
    state: enabled
- name: digital_binary_slicer_fb_0
  id: digital_binary_slicer_fb
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [896, 216.0]
    rotation: 0
    state: enabled
- name: digital_symbol_sync_xx_0
  id: digital_symbol_sync_xx
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    constellation: digital.constellation_bpsk().base()
    damping: '1.0'
    loop_bw: '0.045'
    max_dev: '1.5'
    maxoutbuf: '0'
    minoutbuf: '0'
    nfilters: '128'
    osps: '1'
    pfb_mf_taps: '[]'
    resamp_type: digital.IR_MMSE_8TAP
    sps: sps
    ted_gain: '1.0'
    ted_type: digital.TED_GARDNER
    type: ff
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [688, 308.0]
    rotation: 0
    state: enabled
- name: epy_block_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\nimport reedsolo\n\n\
      class blk(gr.basic_block):\n    \"\"\"CC1120 Robust RS Stream Decoder\"\"\"\n\
      \    def __init__(self, sync_word='00011010110011111111110000011101', threshold=2):\n\
      \        gr.basic_block.__init__(self, name='CC1120 RS Stream Decoder', in_sig=[np.uint8],\
      \ out_sig=[np.uint8])\n        self.sync_bits = np.array([int(b) for b in sync_word],\
      \ dtype=np.uint8)\n        self.sync_len = len(self.sync_bits)\n        self.threshold\
      \ = threshold\n        self.max_packet_len = 128\n        self.rsc = reedsolo.RSCodec(4)\n\
      \        self.state = 'SEARCH_SYNC'\n        self.buffer = []\n        self.len_bits\
      \ = []\n        self.payload_bits = []\n        self.bits_needed = 0\n\n   \
      \ def forecast(self, noutput_items, ninputs):\n        return [max(1, noutput_items\
      \ * 8) for _ in range(ninputs)]\n\n    def general_work(self, input_items, output_items):\n\
      \        in_bits = input_items[0]\n        out = output_items[0]\n        in_idx\
      \ = 0\n        out_idx = 0\n        while in_idx < len(in_bits):\n         \
      \   if self.state == 'READ_PAYLOAD' and out_idx + self.max_packet_len > len(out):\n\
      \                break\n            bit = in_bits[in_idx]\n            in_idx\
      \ += 1\n            if self.state == 'SEARCH_SYNC':\n                self.buffer.append(bit)\n\
      \                if len(self.buffer) > self.sync_len:\n                    self.buffer.pop(0)\n\
      \                if len(self.buffer) == self.sync_len:\n                   \
      \ diffs = np.sum(np.array(self.buffer, dtype=np.uint8) != self.sync_bits)\n\
      \                    if diffs <= self.threshold:\n                        self.state\
      \ = 'READ_LEN'\n                        self.len_bits = []\n            elif\
      \ self.state == 'READ_LEN':\n                self.len_bits.append(bit)\n   \
      \             if len(self.len_bits) == 8:\n                    pkt_len = int(np.packbits(self.len_bits)[0])\n\
      \                    if 5 <= pkt_len <= self.max_packet_len:\n             \
      \           self.bits_needed = pkt_len * 8\n                        self.payload_bits\
      \ = []\n                        self.state = 'READ_PAYLOAD'\n              \
      \      else:\n                        self.state = 'SEARCH_SYNC'\n         \
      \               self.buffer = []\n            elif self.state == 'READ_PAYLOAD':\n\
      \                self.payload_bits.append(bit)\n                if len(self.payload_bits)\
      \ == self.bits_needed:\n                    rs_codeword = bytes(np.packbits(self.payload_bits))\n\
      \                    try:\n                        decoded_payload, _, _ = self.rsc.decode(rs_codeword)\n\
      \                    except Exception:\n                        decoded_payload\
      \ = rs_codeword[:max(0, len(rs_codeword) - 4)]\n                    dec_arr\
      \ = np.frombuffer(decoded_payload, dtype=np.uint8)\n                    available_space\
      \ = len(out) - out_idx\n                    if len(dec_arr) <= available_space:\n\
      \                        out[out_idx : out_idx + len(dec_arr)] = dec_arr\n \
      \                       out_idx += len(dec_arr)\n                    self.state\
      \ = 'SEARCH_SYNC'\n                    self.buffer = []\n        self.consume(0,\
      \ in_idx)\n        return out_idx\n"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    sync_word: '''00011010110011111111110000011101'''
    threshold: sync_threshold
  states:
    _io_cache: ('CC1120 RS Stream Decoder', 'blk', [('sync_word', "'00011010110011111111110000011101'"),
      ('threshold', '2')], [('0', 'byte', 1)], [('0', 'byte', 1)], 'CC1120 Robust
      RS Stream Decoder', ['threshold'])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1072, 204.0]
    rotation: 0
    state: enabled
- name: import_math
  id: import
  parameters:
    alias: ''
    comment: ''
    imports: import math, pmt, sys, os
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 116.0]
    rotation: 0
    state: enabled
- name: low_pass_filter_0
  id: low_pass_filter
  parameters:
    affinity: ''
    alias: ''
    beta: '6.76'
    comment: ''
    cutoff_freq: filter_cutoff
    decim: '1'
    gain: '1'
    interp: '1'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fir_filter_ccf
    width: filter_transition
    win: window.WIN_HAMMING
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [280, 180.0]
    rotation: 0
    state: enabled
- name: soapy_rtlsdr_source_0
  id: soapy_rtlsdr_source
  parameters:
    affinity: ''
    agc: 'False'
    alias: ''
    bias: 'False'
    center_freq: rf_freq
    comment: ''
    dev_args: driver=rtlsdr
    freq_correction: '-15'
    gain: rx_gain
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
    type: fc32
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [32, 212.0]
    rotation: 0
    state: enabled

connections:
- [analog_quadrature_demod_cf_0, '0', digital_symbol_sync_xx_0, '0']
- [digital_binary_slicer_fb_0, '0', epy_block_0, '0']
- [digital_symbol_sync_xx_0, '0', digital_binary_slicer_fb_0, '0']
- [epy_block_0, '0', blocks_file_sink_0, '0']
- [low_pass_filter_0, '0', analog_quadrature_demod_cf_0, '0']
- [soapy_rtlsdr_source_0, '0', low_pass_filter_0, '0']

metadata:
  file_format: 1
  grc_version: 3.10.7.0
