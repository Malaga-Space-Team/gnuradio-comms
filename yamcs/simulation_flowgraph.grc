    bus_source: false
    bus_structure: null
    coordinate: [856, 96.0]
    rotation: 0
    state: enabled
- name: deviation
  id: variable
  parameters:
    comment: ''
    value: '4000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [192, 96.0]
    rotation: 0
    state: enabled
- name: freq_offset
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
    label: frequency correction
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-20000'
    step: '100'
    stop: '20000'
    value: '0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1472, 20.0]
    rotation: 0
    state: enabled
- name: gain
  id: variable
  parameters:
    comment: Quadrature demodulator gain
    value: rx_samp_rate / (2.0 * math.pi * deviation)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [392, 96.0]
    rotation: 0
    state: enabled
- name: hdr_format
  id: variable
  parameters:
    comment: Header - ASM
    value: digital.header_format_default(access_key, 0, 1)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [768, 4.0]
    rotation: 0
    state: enabled
- name: lpf
