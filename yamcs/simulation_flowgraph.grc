- name: blocks_message_strobe_0
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: '0064c000000700000001410f22cf


      [0x55]*197 is the padding defined by CCSDS standard'
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.cons(pmt.PMT_NIL, pmt.init_u8vector(223, [0x00, 0x00, 0x00, 0x00, 0x18,
      0x00, 0x00, 0x64, 0xc0, 0x00, 0x00, 0x07, 0x00, 0x00, 0x00, 0x01, 0x41, 0x0f,
      0x22, 0xcf, 0x07, 0xff, 0xc0, 0x00, 0x00, 0xc4] + [0x55]*197))
    period: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [208, 216.0]
    rotation: 0
    state: true
